# Copy this file to .env and fill in real values. .env is git-ignored.

# Anthropic API key — used by the Research/Curator/Writer/Reviewer agents (from M2)
ANTHROPIC_API_KEY=

# Shared secret the Conductor must send as the x-conductor-secret header on
# every route except /health (docs/R2_BUILD-SPEC.md §4.1)
CONDUCTOR_ACCESS_SECRET=

PORT=3000

# --- Added in M3 (Reviewer's RAG check) ---
# Voyage AI key, used to embed both the seed corpus and each PM Perspective.
EMBEDDING_PROVIDER_API_KEY=

# Content Builder's own Supabase project (pgvector enabled) - the RAG
# corpus's home. Separate from EmailServer's Supabase project entirely
# (docs/R2_BUILD-SPEC.md §1.2, architecture doc §11.2). Use the Project URL
# (https://<ref>.supabase.co), not the "API URL" with /rest/v1/ appended -
# the Supabase client adds that path itself. Use the service_role key, not
# anon - this only ever runs server-side.
CONTENT_BUILDER_SUPABASE_URL=
CONTENT_BUILDER_SUPABASE_SERVICE_KEY=
